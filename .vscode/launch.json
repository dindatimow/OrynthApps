      "args": [
        "--dart-define=FIREBASE_API_KEY=ISI_API_KEY_KAMU",
        "--dart-define=FIREBASE_DB_URL=https://PROJECT_ID-default-rtdb.firebaseio.com"
      ]
    }
  ]
}
